{
  "functions": {
    "api/contract.js": {
      "maxDuration": 60
    },
    "api/lofin.js": {
      "maxDuration": 60
    },
    "api/projects.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "xn--4k0b53xuva.com"
        }
      ],
      "destination": "https://www.xn--4k0b53xuva.com/:path*",
      "permanent": true
    },
    {
      "source": "/narasalim.html",
      "destination": "/budget365.html",
      "permanent": true
    },
    {
      "source": "/narasalim",
      "destination": "/budget365.html",
      "permanent": true
    },
    {
      "source": "/kimbomi_banner.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/feed.xml",
      "destination": "/api/posts?action=rss"
    },
    {
      "source": "/post/:id",
      "destination": "/api/posts?action=page&id=:id"
    },
    {
      "source": "/api/thoughts",
      "destination": "/api/community?kind=thoughts"
    },
    {
      "source": "/api/alerts",
      "destination": "/api/community?kind=alerts"
    },
    {
      "source": "/api/stories",
      "destination": "/api/community?kind=stories"
    },
    {
      "source": "/api/scores",
      "destination": "/api/community?kind=scores"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/story",
      "destination": "/story.html"
    },
    {
      "source": "/vision",
      "destination": "/vision.html"
    },
    {
      "source": "/report",
      "destination": "/report.html"
    },
    {
      "source": "/game",
      "destination": "/game.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?action=cronreport",
      "schedule": "10 15 * * *"
    },
    {
      "path": "/api/contract?warmawards=1",
      "schedule": "40 15 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|svg|ico|gif)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
